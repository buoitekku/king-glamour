# Dostawca handlu: local (dane demo) | shopify | saleor
NEXT_PUBLIC_COMMERCE_PROVIDER=local

# Google Analytics 4 (gtag). Puste = tag nie jest ładowany.
NEXT_PUBLIC_GA_ID=

# Shopify (adapter w przygotowaniu, docs/backend/adapter.md)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Saleor (adapter w przygotowaniu)
SALEOR_API_URL=

# Eksport statyczny (GitHub Pages)
# STATIC_EXPORT=1
# BASE_PATH=/king-glamour
